# Configurações para uspdev/votacao

# dev ou prod
AMBIENTE='dev'

# URL onde está instalado a aplicação
WWWROOT='http://servidor/pasta_raiz'

# Comunicação interna Front <-> API:
# O sistema resolve automaticamente o host do WWWROOT para 127.0.0.1 em memória (CURLOPT_RESOLVE),
# permitindo funcionamento com VirtualHosts sem precisar alterar o /etc/hosts.
# Caso precise customizar o IP ou desabilitar, use:
# API_RESOLVE_IP='127.0.0.1' # 'none' para desabilitar

# sobrescreve a URL da API se necessário. útil quando publico é https e interno é http
# API_URL='http://127.0.0.1/pasta_raiz/api' 

# sqlite ou outro
DB_TIPO='sqlite'

# Se utilizar outro DB, deve preencher o DSN, username e password
DB_DSN='mysql:host=localhost;dbname=votacao'
DB_USERNAME=
DB_PASSWORD=

# Senha unica
# github.com/uspdev/senhaunica
# callback de retorno: http://servidor/pasta_raiz/login
CONSUMER_KEY=''
CONSUMER_SECRET=''
SENHA_UNICA_CALLBACK_ID=''
SENHA_UNICA_AMB='' # prod ou dev

# Como a api está junto, vai criar esse usuário e usar ele para a comunicação
API_USER='admin'
API_PWD='admin'

# Email de envio de mensagens (google)
EMAIL_AUTH_TYPE='log' # plain, tls, ssl, oauth, log (ou deixe EMAIL em branco para salvar em log)
EMAIL_HOST='smtp.gmail.com'
EMAIL_PORT=465

EMAIL=
EMAIL_PWD=

# Caso EMAIL_AUTH_TYPE=oauth, é necessário configurar as credenciais
EMAIL_OAUTH_CLIENT_ID=
EMAIL_OAUTH_CLIENT_SECRET=
EMAIL_OAUTH_REFRESH_TOKEN=

# Número usp do primeiro usuário admin
ADMIN_CODPES=